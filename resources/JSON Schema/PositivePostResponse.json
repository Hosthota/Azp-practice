{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "innerObject": {
      "type": "object",
      "properties": {
        "creationTime": {
          "type": "string",
          "format": "date"
        },
        "endTime": {
          "type": "string",
          "format": "date"
        },
        "entryName": {
          "type": "string"
        }
      },
      "required": [
        "creationTime",
        "endTime",
        "entryName"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "innerObject"
  ],
  "additionalProperties": false
}